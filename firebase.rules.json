{
  "rules": {
    "rooms": {
      "$code": {
        "presence": {
          "$client": {
            ".read": true,
            ".write": "newData.exists() && newData.child('online').isBoolean() && newData.child('lastSeen').isNumber() && !newData.child('hacked').exists()",
            ".validate": "newData.hasChildren(['online', 'lastSeen'])"
          }
        },
        "seats": {
          "$index": {
            ".write": "newData.parent().exists()",
            ".validate": "newData.hasChildren(['id', 'name']) && newData.child('name').isString() && newData.child('name').val().length <= 18"
          }
        },
        "taunts": {
          ".read": true,
          ".write": true,
          "$eventId": {
            ".validate": "newData.hasChildren(['type', 'ts']) && newData.child('type').val().matches(/^(taunt|throw)$/) && newData.child('ts').isNumber()"
          }
        },

        ".read": true,
        ".write": "newData.hasChildren(['code', 'hostId', 'seats', 'status', 'rev']) && newData.child('status').val().matches(/^(lobby|playing|round-end)$/) && newData.child('code').val() === $code"
      }
    }
  }
}
